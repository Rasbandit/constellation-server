#!/usr/bin/env bash
# Conventional commits, subject at most 50 chars (merge, revert and fixup commits pass).
set -euo pipefail
subject=$(head -n1 "$1")
case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?: .+'
if ! [[ $subject =~ $re ]] || (( ${#subject} > 50 )); then
  echo "commit subject must be 'type(scope)?: summary', at most 50 chars. Got: $subject" >&2
  exit 1
fi
