# Placeholders only. Copy to .env; never commit it.
# Image tag to pull (a release tag such as v0.1.0, or latest).
CONSTELLATION_TAG=latest
# Host port that maps to the server's 38281.
CONSTELLATION_PORT=38281
# Files holding the secrets (first line only). Create them yourself, for example:
#   mkdir -p secrets && openssl rand -hex 24 > secrets/postgres_password
#   printf 'postgres://constellation:%s@postgres/constellation' "$(cat secrets/postgres_password)" > secrets/database_url
CONSTELLATION_DATABASE_URL_FILE=./secrets/database_url
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
# Admin API token file, at least 32 bytes: openssl rand -hex 16 > secrets/admin_token
CONSTELLATION_ADMIN_TOKEN_FILE=./secrets/admin_token
# Host the join addresses are shown under, and the admin API's host port (loopback only).
CONSTELLATION_PUBLIC_HOST=localhost
CONSTELLATION_ADMIN_PORT=38282
# The generator source: a git URL and a pinned commit SHA (build args; the release workflow takes them from a repository secret and a variable).
GEN_REPO_URL=
GEN_REPO_REF=
