# Placeholders only. Copy to .env; never commit it.
# Image tag to pull (a release tag such as v0.1.0, or latest).
CONSTELLATION_TAG=latest
# Host port that maps to the server's 38281 (rooms, the web UI and /api, which needs a login).
CONSTELLATION_PORT=38281
# Files holding the secrets (first line only). Create them yourself, for example:
#   mkdir -p secrets && openssl rand -hex 24 > secrets/postgres_password
#   openssl rand -hex 24 > secrets/app_password; openssl rand -hex 24 > secrets/migrate_password
#   printf 'postgres://constellation_app:%s@postgres/constellation' "$(cat secrets/app_password)" > secrets/database_url
#   printf 'postgres://constellation_migrate:%s@postgres/constellation' "$(cat secrets/migrate_password)" > secrets/migrate_database_url
# The server runs as the runtime role (database_url) and migrates as the table owner
# (migrate_database_url); postgres_password is the bootstrap superuser, used only to set up and check health.
CONSTELLATION_DATABASE_URL_FILE=./secrets/database_url
CONSTELLATION_MIGRATE_DATABASE_URL_FILE=./secrets/migrate_database_url
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
POSTGRES_APP_PASSWORD_FILE=./secrets/app_password
POSTGRES_MIGRATE_PASSWORD_FILE=./secrets/migrate_password
# Host the join addresses are shown under.
CONSTELLATION_PUBLIC_HOST=localhost
# The generator source: a git URL and a pinned commit SHA (build args; the release workflow takes them from a repository secret and a variable).
GEN_REPO_URL=
GEN_REPO_REF=
