        "description": "`state.changed` payload.",
        "properties": {
          "path": {
            "$ref": "#/$defs/StatePath",
            "description": "The watched path."
          },
          "value": {
            "description": "Its new value."
          },
          "ver": {
            "$ref": "#/$defs/Seq",
            "description": "The `seq` that last changed it."
          }
        },
        "required": [
          "path",
          "value",
          "ver"
        ],
        "title": "StateChanged",
        "type": "object"
      },
      "delivery": "ephemeral",
      "kind": "event",
      "name": "state.changed",
