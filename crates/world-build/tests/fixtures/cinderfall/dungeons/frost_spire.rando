# The frost spire: two small keys and a great key.
use items
use logic

region frost_entry placement frost_keys {
  check icicle_chest
  check frozen_urn: can_burn
  exit frost_gate
  exit frost_stair
}

region frost_stair placement frost_keys {
  for i in 1..3 {
    check stair_landing_{i}
  }
  exit frost_entry
  exit frost_gallery: keys(frost_key, 1)
  exit frost_bell: keys(frost_key, 2) and can_lift(2)
}

region frost_gallery placement frost_keys {
  for i in 1..3 {
    check gallery_statue_{i}: can_shoot
  }
  check gallery_mirror: can_shoot
  check gallery_chest
  check ice_block: can_burn
  exit frost_stair
}

region frost_bell placement frost_keys {
  check bell_chamber
  check bell_clapper: can_fight(2)
  exit frost_stair
  exit frost_lair: has(frost_great_key)
}

region frost_lair placement frost_keys {
  check frost_heart: can_fight(3) and can_burn holds relic
  check frost_spoils: can_fight(2)
  exit frost_bell
}
