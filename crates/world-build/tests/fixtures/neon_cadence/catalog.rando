region song_select {
  for s in song {
    exit {s.key}: has({s.pack}_pack) and count(tier_pass) >= s.tier - 1
  }
}

for s in song {
  region {s.key} {
    for d in chart where d.focus <= 1 or opt.expert_charts, g in objective {
      check {s.key}_{d.key}_{g.key}: count(focus_lens) >= d.focus and g.need
    }
    event song_cleared: true
    exit song_select
  }
}
