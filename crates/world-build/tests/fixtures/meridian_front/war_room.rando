# The war room is where every mission and finale is launched from. A mission needs its
# planet's coordinates and, with `campaign_order` at `tree`, the missions before it in the
# tree; at `open` the coordinates alone decide.
use campaign
use finales

region war_room {
  # Each family repeats its regions' `where`: see the README.
  for m in mission where in_campaign(m.chapter, m.side) {
    exit {m.key}: has({m.planet}_coordinates) and (opt.campaign_order == open or m.after)
  }
  for f in finale where in_campaign(f.chapter, false) {
    exit {f.key}: has({f.planet}_coordinates) and (opt.campaign_order == open or f.after)
  }
}
