# The four towns. Each has a shop with `shop_slots` shelves, an inn and a quest or two.
use items
use logic

region millbrook {
  for s in 1..5 where s <= opt.shop_slots {
    check millbrook_shop_{s} no_progression opt.safe_shops
  }
  check millbrook_inn_chest
  check elder_request
  check locked_cellar: can_pick_locks
  exit west_fields
}

region saltmere {
  for s in 1..5 where s <= opt.shop_slots {
    check saltmere_shop_{s} no_progression opt.safe_shops
  }
  check saltmere_inn_chest
  check harbor_master: has(ferry_pass)
  check fishwife_errand
  exit west_fields
  exit salt_coast
  exit lighthouse_steps: has(skiff)
}

region cragholm {
  for s in 1..5 where s <= opt.shop_slots {
    check cragholm_shop_{s} no_progression opt.safe_shops
  }
  check cragholm_inn_chest
  check smith_commission: rank(2)
  exit frost_pass
  exit mine_entrance: has(miners_lamp)
}

region sunspire {
  for s in 1..5 where s <= opt.shop_slots {
    check sunspire_shop_{s} no_progression opt.safe_shops
  }
  check sunspire_inn_chest
  check royal_audience: party(2)
  check treasury_vault: can_pick_locks and rank(3)
  exit ashen_road
  exit keep_gate: has(royal_seal) and party(opt.party_needed)
}
