# A volcano: lava rivers, crumbling rocks and hot updrafts.
use items

region cinder_caldera {
  check obsidian_gem
  check lava_bridge_gem: has(roll_dash)
  check geyser_gem: has(glide_cape)
  # Seed pods lie all over: four down here, four further in. `pods_per_world` of the eight
  # are checks.
  for i in 1..4 where i <= opt.pods_per_world {
    check cinder_caldera_pod_{i}
  }
  exit caldera_core: has(roll_dash)
  exit hub_meadow
}

region caldera_core {
  check magma_golem_gem: has(ground_pound)
  check ember_race_gem: can_reach_high
  check crater_rim_gem: has(high_bounce)
  for i in 5..8 where i <= opt.pods_per_world {
    check cinder_caldera_pod_{i}
  }
  exit cinder_caldera
}
