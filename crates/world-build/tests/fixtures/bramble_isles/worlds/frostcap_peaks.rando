# Snowy mountains with frozen lakes and ice caves.
use items

region frostcap_peaks {
  check snowman_gem
  check ice_lake_gem: has(swim_fins)
  check ski_slope_gem: has(roll_dash)
  # Seed pods lie all over: four down here, four further in. `pods_per_world` of the eight
  # are checks.
  for i in 1..4 where i <= opt.pods_per_world {
    check frostcap_peaks_pod_{i}
  }
  exit frostcap_summit: can_reach_high
  exit hub_meadow
}

region frostcap_summit {
  check yeti_gem: has(ground_pound)
  check icicle_gem: has(high_bounce) and has(glide_cape)
  check aurora_gem
  for i in 5..8 where i <= opt.pods_per_world {
    check frostcap_peaks_pod_{i}
  }
  exit frostcap_peaks
}
