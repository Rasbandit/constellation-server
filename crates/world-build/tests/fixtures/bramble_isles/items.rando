# Lucky marbles are the main collectible: they open the worlds and the summit.
item lucky_marble progression x 30

# Moves the player learns. Each opens a kind of obstacle in every world.
item ground_pound progression
item glide_cape progression
item swim_fins progression
item high_bounce progression
item roll_dash progression

# Minor rewards: pebbles, bonus tickets, health and a hat. Filler fills every check the marbles
# and moves leave.
item health_berry useful x 4
item shiny_pebble filler
item bonus_ticket filler
item fancy_hat filler
item rain_cloud trap
pool fill { shiny_pebble 10, bonus_ticket 4, fancy_hat 1, rain_cloud 1 }

# Two moves reach high places: either one gets up a tall ledge.
group lift_moves = { glide_cape, high_bounce }
def can_reach_high = group_count(lift_moves) >= 1
