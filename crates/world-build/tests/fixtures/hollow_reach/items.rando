# Movement abilities are the progression: each one opens a kind of obstacle across the map.
item vault_boots progression
item rush_core progression
item grip_claws progression
item hook_line progression
item tide_lung progression
item shatter_charge progression
item lumen_moth progression

# Upgrades that make the run easier but never open a path.
item life_shard useful x 8
item energy_cell useful x 4
item map_fragment useful x 5

item scrap filler
item static_burst trap
pool fill { scrap 10, static_burst 1 }

group movement = { vault_boots, rush_core, grip_claws, hook_line }
