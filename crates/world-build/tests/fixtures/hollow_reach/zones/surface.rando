# The surface: where the player lands, and the hub every zone loops back to.
use items
use logic

region landing_site {
  check crash_debris
  check escape_pod
  check tall_antenna: can_reach_high
  exit ruined_gate
  exit windy_bluff: can_reach_high
}

region ruined_gate {
  check gate_statue
  check rubble_pile: can_break_walls
  exit landing_site
  exit overgrown_terrace
  exit cavern_mouth
  # The gate's upper arch leads straight to the spire once the hook can reach it.
  exit spire_base: has(hook_line)
}

region overgrown_terrace {
  check vine_nest
  check terrace_shrine
  check hanging_garden: can_climb_shaft
  exit ruined_gate
  exit archive_atrium: can_cross_gap
}

region windy_bluff {
  check bluff_cairn
  check updraft_ledge: can_cross_gap
  exit landing_site
  # A one-way drop: the bluff falls into the caverns, and there is no climbing back up here.
  exit crystal_pit
}
