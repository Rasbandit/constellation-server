# The core: the last zone, under the caverns. Its gate counts the guardians that have fallen:
# each guardian's lair fires `guardian_down`, and the counter is how many of them did.
use items
use logic

region core_gate {
  check gate_inscription
  check sealed_reliquary: counter(guardian_down) >= 1
  exit crystal_pit: can_climb_shaft
  exit core_heart: counter(guardian_down) >= opt.guardians_needed
}

region core_heart {
  check heart_reliquary
  event core_silenced: can_fight_guardian and can_see_dark
  exit core_gate
}
